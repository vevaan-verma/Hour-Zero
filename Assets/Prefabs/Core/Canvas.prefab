  npcNameText: {fileID: 1499055973757554670}
  interactSection: {fileID: 5541644743544526469}
  teamButton: {fileID: 3553968825301533565}
  talkButton: {fileID: 602293528887323251}
  tradeButton: {fileID: 1162705292726529418}
  trackButton: {fileID: 8902139043906625294}
  untrackButton: {fileID: 7654300054102439661}
  dialogueSection: {fileID: 6576962518026640509}
  dialogueText: {fileID: 3994393793754947643}
  okayButton: {fileID: 2111087935006549985}
  closeMenuButton: {fileID: 4610874787949895102}
  menuFadeDuration: 0.25
  dialogueCharactersPerSecond: 75
  alreadyAssignedTaskSequences:
  - dialogueLines:
    - "I\u2019m not just going to trust someone with unfinished business."
  - dialogueLines:
    - That would be like hiring someone mid-toilet flush. Finish the job.
  - dialogueLines:
    - "Trying to skip ahead? That\u2019s adorable. But no."
  - dialogueLines:
    - "Unless you\u2019ve suddenly mastered quantum duplication, you\u2019re still
      on a task. Come back when you're useful."
  - dialogueLines:
    - "Trust isn\u2019t a group discount. One loyalty test at a time, thanks."
  - dialogueLines:
    - "Whoa there, multitasker. Let\u2019s see you complete one apocalypse quest
      at a time."
  - dialogueLines:
    - "You can\u2019t even carry trust from one person. What makes you think you
      can carry it from two?"
  - dialogueLines:
    - "You\u2019ve already got a mission. You think this is a buffet?"
